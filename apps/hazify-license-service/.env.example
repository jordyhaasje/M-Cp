PORT=8787
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DATA_ENCRYPTION_KEY=generate-a-long-random-encryption-key
BACKUP_EXPORT_KEY=
BACKUP_EXPORT_DIRECTORY=data/backups
BACKUP_EXPORT_POLICY=encrypted
# Production requires distinct random secrets of at least 32 characters.
ADMIN_API_KEY=generate-a-long-random-admin-secret
MCP_API_KEY=generate-a-long-random-mcp-secret
PUBLIC_BASE_URL=https://license.your-domain.com
MCP_PUBLIC_URL=https://mcp.your-domain.com/mcp
LICENSE_GRACE_HOURS=72
READ_ONLY_GRACE_DAYS=7
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=1048576
TIMESTAMP_SKEW_SECONDS=900
ONBOARDING_LOGO_PATH=./logo.png
OAUTH_ISSUER=
OAUTH_ALLOWED_CUSTOM_REDIRECT_SCHEMES=vscode,cursor,claude,perplexity
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_CODE_TTL_MINUTES=10
ACCOUNT_SESSION_TTL_DAYS=14

# Beginfase/default: free onboarding mode (no checkout required).
# Production free mode moet expliciet blijven; Stripe kan later aan met HAZIFY_BILLING_MODE=stripe.
HAZIFY_BILLING_MODE=free
HAZIFY_FREE_MODE=true
# Test-only override; production startup rejects this when true.
HAZIFY_AUTO_ACTIVATE_SIGNUP_LICENSES=false

# Optional Stripe integration (only used when HAZIFY_BILLING_MODE=stripe)
STRIPE_BILLING_ENABLED=false
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_MONTHLY_PAYMENT_LINK=
STRIPE_YEARLY_PAYMENT_LINK=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
PORTAL_RETURN_URL=
